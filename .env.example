# Modelo de configuração local. Copie para .env e preencha com os dados do
# projeto Supabase EXCLUSIVO de exercícios do seu grupo. Nunca versione o .env.
# Todos os valores abaixo são fictícios.

# Connection string do Session pooler (IPv4), copiada do painel do Supabase:
# Connect > Connection string > Session pooler. Troque [SENHA] pela senha do
# banco; se a senha tiver caracteres especiais (@ : / # ? % &), escreva-os
# codificados (por exemplo, @ vira %40). Mantenha ?sslmode=require (TLS).
BANCO_URL=postgresql://postgres.abcdefghijklmnopqrst:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Autoriza recriar o esquema loja (python recriar_banco.py) e rodar os testes de
# banco, que recriam os dados antes de cada teste. Use "sim" apenas no projeto
# de exercícios.
PERMITIR_RECRIACAO=nao

# Fuso horário da loja (define a semana atual no relatório).
FUSO_LOJA=America/Sao_Paulo

# Chave usada pelo Flask para assinar as mensagens entre páginas.
CHAVE_SECRETA=troque-por-um-texto-aleatorio
